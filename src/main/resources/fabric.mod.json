{
  "schemaVersion": 1,
  "id": "scrolls",
  "version": "${version}",
  "name": "Scrolls",
  "description": "Allows Luau Scripting in Datapacks",
  "authors": [],
  "contact": {},
  "license": "LGPL-3.0",
  "icon": "assets/scrolls/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "de.cjdev.scrolls.Scrolls"
    ]
  },
  "mixins": [
    "scrolls.mixins.json"
  ],
  "accessWidener": "scrolls.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": ">=26.1-pre.2"
  },
  "custom": {
    "fabric-loom": {
      "tweakers": [
        "de.cjdev.scrolls.processor.LuaClassTransformer"
      ]
    }
  }
}
